{
  "version": "2.0",
  "functionTimeout": "00:10:00",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "serviceBus": {
      "maxConcurrentCalls": 16,
      "prefetchCount": 32,
      "maxConcurrentSessions": 200,
      "maxMessageBatchSize": 1000,
      "minMessageBatchSize": 1,
      "maxBatchWaitTime": "00:00:10"
    },
    "eventHubs": {
      "maxBatchSize": 1000,
      "minBatchSize": 10,
      "maxWaitTime": "00:00:05",
      "prefetchCount": 300,
      "targetUnprocessedEventThreshold": 300,
      "batchCheckpointFrequency": 1
    }
  }
}
