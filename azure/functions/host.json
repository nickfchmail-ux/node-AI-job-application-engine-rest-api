{
  "version": "2.0",
  "functionTimeout": "00:10:00",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "queues": {
      // Storage Queue triggers (FREE replacement for Service Bus).
      // messageEncoding base64 matches what the producer base64-encodes.
      // visibilityTimeout is 10min (matches functionTimeout) so a slow job
      // detail fetch is NOT re-delivered mid-processing — a re-delivery loop
      // (visibility < processing time) was stalling runs in `retrying` and
      // never letting them finalize to `completed`.
      "visibilityTimeout": "00:10:00",
      "maxDequeueCount": 5,
      "batchSize": 4,
      "newBatchThreshold": 2,
      "messageEncoding": "base64"
    },
    "eventHubs": {
      "maxBatchSize": 1000,
      "minBatchSize": 10,
      "maxWaitTime": "00:00:05",
      "prefetchCount": 300,
      "targetUnprocessedEventThreshold": 300,
      "batchCheckpointFrequency": 1
    }
  }
}
