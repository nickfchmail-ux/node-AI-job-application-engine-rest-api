{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jobboard-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1.0
  },
  "vars": {
    "ALLOWED_ORIGINS": ""
  }
}
